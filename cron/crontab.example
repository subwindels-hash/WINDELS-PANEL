# =============================================================================
# MarvySocials — example crontab for background jobs
# =============================================================================
# Copy to the www user's crontab and adjust the PATH to your document root:
#
#     crontab -u www-data -e        # then paste the lines below
#     crontab -u www-data -l        # verify
#
# Replace /var/www/marvysocials with the real document root (where index.php lives).
# Each job takes an exclusive lock (JobRunner/flock), so overlapping ticks are safe.
# Run `php index.php cron` (no job) to list jobs with their configured schedule.
# -----------------------------------------------------------------------------

PATH=/usr/local/bin:/usr/bin:/bin
MYPANEL=/var/www/marvysocials

# --- order / fulfilment status polling (frequent) ------------------------------
*/3  * * * *  cd $MYPANEL && php index.php cron order_status
*/5  * * * *  cd $MYPANEL && php index.php cron vtu_status
*/5  * * * *  cd $MYPANEL && php index.php cron numbers_status
*/5  * * * *  cd $MYPANEL && php index.php cron refill_status
*/5  * * * *  cd $MYPANEL && php index.php cron dripfeed
*/15 * * * *  cd $MYPANEL && php index.php cron giftcard_codes
*/10 * * * *  cd $MYPANEL && php index.php cron service_recovery   # refunds purchases no worker can settle (no provider reference / vendor stopped answering)
*/5  * * * *  cd $MYPANEL && php index.php cron payment_reconciliation  # asks each gateway about deposits whose callback never arrived
*/5  * * * *  cd $MYPANEL && php index.php cron email_queue
*/10 * * * *  cd $MYPANEL && php index.php cron provider_health
*/10 * * * *  cd $MYPANEL && php index.php cron earnings_release   # releases held referral earnings once the holding period elapses
*/5  * * * *  cd $MYPANEL && php index.php cron fundsvera_expire   # expires unpaid FundsVera checkout sessions

# --- every 30 minutes --------------------------------------------------------
*/30 * * * *  cd $MYPANEL && php index.php cron marketplace_release
*/30 * * * *  cd $MYPANEL && php index.php cron provider_sync

# --- hourly ------------------------------------------------------------------
0    * * * *  cd $MYPANEL && php index.php cron subscriptions
0    * * * *  cd $MYPANEL && php index.php cron pin_rotation        # auto-rotate security PINs (24h window)

# --- daily --------------------------------------------------------------------
13   3 * * *  cd $MYPANEL && php index.php cron identity_purge
27   4 * * *  cd $MYPANEL && php index.php cron analytics
41   5 * * *  cd $MYPANEL && php index.php cron affiliate_payouts
