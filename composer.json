{
  "name": "windels/panel",
  "description": "WINDELS PANEL \u2014 Enterprise SMM Reseller Platform (CodeIgniter 3.x + MySQL/MariaDB)",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "codeigniter/framework": "3.1.13",
    "predis/predis": "^2.0",
    "ramsey/uuid": "^4.7",
    "robinvdvleuten/ulid": "^1.2",
    "aws/aws-sdk-php": "^3.300",
    "guzzlehttp/guzzle": "^7.8",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Windels\\": "application/libraries/"
    },
    "files": [
      "application/helpers/windels_helper.php"
    ],
    "classmap": [
      "application/libraries/Seeder.php"
    ]
  },
  "scripts": {
    "post-install-cmd": [
      "@php tools/link_system.php"
    ],
    "post-update-cmd": [
      "@php tools/link_system.php"
    ],
    "test": "phpunit",
    "test:offline": "php tools/phpunit_lite.php",
    "analyse": "phpstan analyse --no-progress",
    "preflight": "php index.php deploy check",
    "migrate": "php index.php migrate",
    "migrate:fresh": "php index.php migrate fresh",
    "seed": "php index.php seed core",
    "seed:demo": "php index.php seed demo",
    "schema:export": "php tools/export_schema.php",
    "schema:check": "php tools/export_schema.php --check"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
