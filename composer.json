{
  "name": "windels/panel",
  "description": "WINDELS PANEL — Enterprise SMM Reseller Platform (CodeIgniter 3.x + MySQL/MariaDB)",
  "type": "project",
  "require": {
    "php": ">=7.4",
    "codeigniter/framework": "3.1.13",
    "predis/predis": "^2.0",
    "ramsey/uuid": "^4.7",
    "robinvdvleuten/ulid": "^1.2",
    "aws/aws-sdk-php": "^3.300",
    "guzzlehttp/guzzle": "^7.8",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Windels\\": "application/libraries/"
    },
    "files": [
      "application/helpers/windels_helper.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php index.php migrate"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
