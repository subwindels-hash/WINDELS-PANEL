# WINDELS PANEL — Environment Configuration
# Copy to .env and fill real values. Never commit .env.
# See application/config/*.php for usage (getenv / $_ENV)

APP_ENV=development
APP_URL=http://localhost:8080
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_KEY=base64:change-me-32chars-encryption-key-for-at-rest
ENCRYPTION_KEY=change-me-32-byte-base64-key-please-replace

# Database — MySQL / MariaDB
DB_DRIVER=mysqli
DB_HOST=mysql
DB_PORT=3306
DB_NAME=windels_panel
DB_USER=windels
DB_PASSWORD=windels_secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Redis — cache / rate limiting / distributed locks
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=windels:

# Session — database | redis
SESS_DRIVER=redis
SESS_SAVE_PATH=tcp://redis:6379?prefix=windels_sess:
SESS_COOKIE_NAME=windels_session
SESS_EXPIRATION=7200

# Storage — S3-compatible (AWS S3 / Cloudflare R2 / MinIO dev)
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=windels-panel
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_URL=

# Email — SMTP or API
MAIL_DRIVER=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_CRYPTO=
MAIL_FROM_ADDRESS=noreply@windels.local
MAIL_FROM_NAME=WINDELS PANEL

# Payment gateways — keys via env, never in repo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
FLUTTERWAVE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYSTACK_SECRET_KEY=
COINPAYMENTS_PRIVATE_KEY=

# App
MAINTENANCE_MODE=false
DEMO_MODE=false
