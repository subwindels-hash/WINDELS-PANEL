# =============================================================================
# MarvySocials — .env template
#
# Copy to ".env" and fill in the values. Every key below is actually read by
# the application; anything you leave out falls back to a shared-hosting-safe
# default documented inline. Nothing here is guesswork — regenerate the audit
# with:  php tools/audit_env.php
#
# Naming: the canonical names start with VP_. The application also accepts the
# plain CodeIgniter-style names (VP_DB_HOST = DB_HOST, VP_BASE_URL = APP_URL,
# VP_ENCRYPTION_KEY = ENCRYPTION_KEY, VP_AUTH_SECRET = APP_KEY, …) — if both
# are set, the plain name wins. Use the VP_ names; they cannot collide with
# anything else on a shared account.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the panel refuses to serve production traffic without these
# -----------------------------------------------------------------------------

# Environment: production | development | testing
CI_ENV=production

# Public URL of the panel, with trailing slash optional. https on any live domain.
VP_BASE_URL=https://yourdomain.com

# Database (cPanel → MySQL Databases). VP_DB_HOST/VP_DB_PORT default to
# localhost:3306 and may be omitted there.
VP_DB_HOST=localhost
VP_DB_PORT=3306
VP_DB_NAME=
VP_DB_USER=
VP_DB_PASS=

# Strict SQL mode for writes (default true). Leave on.
# VP_DB_STRICT=true

# 64-hex or 32+ random characters. Encrypts provider keys, API secrets and
# gift-card codes at rest. The panel refuses to boot with the empty/example
# value. Generate: curl https://yourdomain-any … or `openssl rand -hex 32`.
VP_ENCRYPTION_KEY=

# 32+ random characters. Signs password-reset and email-verification links.
# MOVING SERVERS: copy these two values UNCHANGED from the old server, or
# previously encrypted data / issued links stop working. Provider and gateway
# secrets are stored encrypted in the database, so they travel with it — the
# key (VP_ENCRYPTION_KEY) and this signing secret are what stay put.
VP_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Application behaviour
# -----------------------------------------------------------------------------

# Debug logging (errors get stack traces in logs). NEVER true in production.
VP_DEBUG=false

# Timezone for date handling (default UTC).
VP_TIMEZONE=UTC

# Setup wizard: set to 32 random chars, open /setup?token=<value>, then REMOVE
# this line. Without it the route returns 404. Lets you replace the seeded
# admin credentials before the first login.
# VP_SETUP_TOKEN=

# CSRF token lifetime (seconds) and rotation. Rotation off keeps long-lived
# tabs working; turn on if you prefer per-request tokens.
VP_CSRF_EXPIRE=7200
VP_CSRF_REGENERATE=false
# Cookie security: automatically true over HTTPS, false over HTTP.
# Override explicitly if testing on HTTP: VP_COOKIE_SECURE=false
# VP_COOKIE_SECURE=false

# Read-only demo mode. Must stay false for a real panel (Preflight and the
# demo-seeder both guard it).
DEMO_MODE=false

# -----------------------------------------------------------------------------
# Mail — default works on every cPanel account (PHP mail()); switch to SMTP
# for deliverability
# -----------------------------------------------------------------------------

# mail | smtp | sendmail
VP_MAIL_DRIVER=mail

# SMTP settings — required only when VP_MAIL_DRIVER=smtp
# (cPanel → Email Accounts → Connect Devices lists host/user; port 465 ssl or 587 tls)
# VP_MAIL_HOST=
# VP_MAIL_PORT=587
# VP_MAIL_USER=
# VP_MAIL_PASS=
# VP_MAIL_CRYPTO=tls

# Sender identity. These are the defaults until an operator overrides them in
# Admin → Settings (mail_from_email / mail_from_name).
VP_MAIL_FROM_ADDRESS=noreply@yourdomain.com
VP_MAIL_FROM_NAME=MarvySocials

# Log each outbound message to storage/logs instead of only sending (debugging).
MAIL_LOG=false

# -----------------------------------------------------------------------------
# Sessions — files on disk by default (works everywhere)
# -----------------------------------------------------------------------------

# files | database | redis   (database → sessions row in MySQL; redis needs the
# Redis block below)
VP_SESSION_DRIVER=files
VP_SESSION_COOKIE=marvy_session
VP_SESSION_EXPIRATION=7200
# When VP_SESSION_DRIVER=redis, also set VP_SESSION_SAVE_PATH — see the Redis
# block below (it references VP_REDIS_PASSWORD, so it must come after it).

# -----------------------------------------------------------------------------
# Storage — local uploads by default. S3/R2 wiring lands with the object
# storage driver (see module map); config is read today so credentials can
# already live here.
# -----------------------------------------------------------------------------

VP_STORAGE_DRIVER=local
# VP_STORAGE_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# VP_STORAGE_REGION=eu-west-1
# VP_STORAGE_BUCKET=
# VP_STORAGE_ACCESS_KEY=
# VP_STORAGE_SECRET_KEY=
# VP_STORAGE_URL=                        # public base URL of the bucket/CDN
# VP_UPLOAD_URL=                         # default: <VP_BASE_URL>/assets/uploads

# -----------------------------------------------------------------------------
# Redis — optional (sessions, rate limits, cache). Commented out = disabled.
# -----------------------------------------------------------------------------

# VP_REDIS_ENABLED=false
# VP_REDIS_HOST=127.0.0.1
# VP_REDIS_PORT=6379
# VP_REDIS_PASSWORD=
# VP_REDIS_DB=0
# VP_REDIS_PREFIX=marvy:

# Only when VP_SESSION_DRIVER=redis (keep AFTER VP_REDIS_PASSWORD — the
# ${…} interpolation resolves against keys defined above it):
# VP_SESSION_SAVE_PATH=tcp://127.0.0.1:6379?auth=${VP_REDIS_PASSWORD}

# -----------------------------------------------------------------------------
# Path overrides — commented out = auto-created defaults under the project
# (storage/logs, storage/cache, storage/cache/sessions, storage/cache/ratelimit,
#  application/cache, assets/uploads)
# -----------------------------------------------------------------------------

# VP_STORAGE_PATH=
# VP_LOG_PATH=
# VP_CACHE_PATH=
# VP_SESSION_PATH=
# VP_RATELIMIT_PATH=
# VP_UPLOAD_PATH=

# -----------------------------------------------------------------------------
# Payment gateways — OPTIONAL. Manual/bank-transfer works out of the box with
# zero keys. The six API gateways below ship as adapters currently being
# wired into PaymentService (see config/payment_gateways.php: enabled=FALSE);
# fill these in the day you enable one. Generic per-gateway webhook fallback:
# MARVYSOCIALS_<GATEWAY>_WEBHOOK_SECRET  (e.g. MARVYSOCIALS_PAYSTACK_WEBHOOK_SECRET).
# -----------------------------------------------------------------------------

# VP_STRIPE_SECRET_KEY=
# VP_STRIPE_WEBHOOK_SECRET=
# VP_PAYPAL_CLIENT_ID=
# VP_PAYPAL_SECRET=
# VP_FLUTTERWAVE_SECRET_KEY=
# VP_RAZORPAY_KEY_ID=
# VP_RAZORPAY_KEY_SECRET=
# VP_PAYSTACK_SECRET_KEY=
# VP_PAYSTACK_PUBLIC_KEY=
# VP_COINPAYMENTS_MERCHANT_ID=
# VP_COINPAYMENTS_IPN_SECRET=

# -----------------------------------------------------------------------------
# Upstream providers — OPTIONAL. All four adapters are live; mock providers are
# used automatically when keys are absent (and are refused in production,
# where a missing key instead shows the feature as unconfigured).
# -----------------------------------------------------------------------------

# VTU (airtime/data/cable) — VTpass
# VP_VTPASS_BASE_URL=https://vtpass.com/api
# VP_VTPASS_API_KEY=
# VP_VTPASS_PUBLIC_KEY=
# VP_VTPASS_SECRET_KEY=

# Virtual numbers — 5sim
# VP_FIVESIM_BASE_URL=https://5sim.net/v1
# VP_FIVESIM_API_KEY=
# VP_FIVESIM_RATE_TO_BASE=

# Identity / KYC (NIN, BVN) — Dojah
# VP_DOJAH_BASE_URL=https://api.dojah.io
# VP_DOJAH_API_KEY=
# VP_DOJAH_APP_ID=

# Gift cards — Reloadly
# Sandbox is the shipped default. Switch to the live wallet
# (https://giftcards.reloadly.com) only for real gift-card operations.
# VP_RELOADLY_BASE_URL=https://giftcards-sandbox.reloadly.com
# VP_RELOADLY_CLIENT_ID=
# VP_RELOADLY_CLIENT_SECRET=
# GIFTCARD_COUNTRIES=US,GB,NG

# -----------------------------------------------------------------------------
# Development / local tooling only
# -----------------------------------------------------------------------------

# SSRF guard — never allow private IP ranges in production. Dev only, when the
# provider sandbox lives on your own LAN.
HTTP_ALLOW_PRIVATE_HOSTS=false

# Demo dataset password (php index.php seed demo; refused under APP_ENV=production).
# DEMO_PASSWORD=

# docker-compose development stack only (MinIO console):
# MINIO_ROOT_USER=marvy
# MINIO_ROOT_PASSWORD=

# Disable the bundled /deploy-verify.php diagnostics page (or delete the file).
# VP_VERIFY_DISABLE=0

# -----------------------------------------------------------------------------
# Fundsvera — Nigerian bank transfer collections (https://fundsvera.co/docs)
# -----------------------------------------------------------------------------
# Collections only: Fundsvera issues virtual accounts and secured-checkout
# transfer accounts and calls a webhook when money arrives. It documents no
# disbursement endpoint, so earnings payouts do NOT go through it.
#
# These may also be set from Admin -> Settings -> Bank transfers, which stores
# them in the database. The environment wins when both are present.
FUNDSVERA_ENABLED=false
FUNDSVERA_BASE_URL=https://fundsvera.co/api/v1
FUNDSVERA_PUBLIC_KEY=
FUNDSVERA_SECRET_KEY=

# Optional. Fundsvera signs webhooks with the SECRET KEY above, so leave this
# blank unless they issue you a separate webhook secret. With neither set, the
# panel treats every callback as unverifiable and credits nothing.
FUNDSVERA_WEBHOOK_SECRET=

# Callback URL to paste into your Fundsvera business profile:
#   https://yourdomain.com/api/payments/webhooks/fundsvera
