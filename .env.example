# WINDELS PANEL — environment configuration
# =============================================================================
# Copy this file to `.env` in the same directory as index.php and fill it in.
# On cPanel: File Manager → select .env.example → Copy → rename to .env → Edit.
#
# This file is the ONLY thing a deployment configures. There is no installer,
# no generated secrets file, no build step: the app reads .env at boot through
# application/core/Env.php, creates its own runtime directories, and starts.
#
# Migrating to another cPanel account is:
#   1. upload the files          (File Manager)
#   2. create database + user    (MySQL Databases)
#   3. import database/production.sql  (phpMyAdmin)
#   4. edit the values below     (File Manager → Edit)
#   5. open the domain
#
# Full walkthrough: docs/cpanel-deployment.md
#
# Booleans: 1, true, yes, on are true. Everything else — including the literal
# word "false" — is false.
# =============================================================================


# --- 1. The five values a migration actually changes -------------------------

# production | development. Leave this on production for a live panel: it turns
# off error output, turns on strict secret checks and secure cookies.
CI_ENV=production

# The address this panel answers on, with scheme, no trailing path.
# Session cookies are marked Secure automatically when this is https://.
VP_BASE_URL=https://yourdomain.com

# cPanel → MySQL Databases. The user must be assigned to the database with
# ALL PRIVILEGES. cPanel prefixes both names with your account, e.g.
# "cpaneluser_windels" / "cpaneluser_panel".
VP_DB_HOST=localhost
VP_DB_PORT=3306
VP_DB_NAME=YOUR_DATABASE_NAME
VP_DB_USER=YOUR_DATABASE_USER
VP_DB_PASS=YOUR_DATABASE_PASSWORD


# --- 2. Secrets — generate ONCE, then carry them between servers -------------
#
# These two are what make a migration lossless. Provider API keys, TOTP secrets
# and gift card codes in the database are encrypted with VP_ENCRYPTION_KEY;
# password-reset and email-verification links are signed with VP_AUTH_SECRET.
# Move the database to a new host with different values and the encrypted rows
# become unreadable — so copy these across unchanged.
#
# For a brand new install, generate them anywhere that can produce 32+ random
# characters (a password manager is fine — no terminal required):
#   openssl rand -base64 32
# The panel refuses to start in production while VP_ENCRYPTION_KEY is empty,
# shorter than 32 characters, or still an example value.
VP_ENCRYPTION_KEY=
VP_AUTH_SECRET=

# Optional. While this is set (16+ characters), /setup?token=... is reachable:
# a browser page that reports what the deployment is missing and lets you set
# the administrator's own username, email and password. Delete the line when
# you are done and the page 404s again. Leave it empty on a healthy panel.
VP_SETUP_TOKEN=


# --- 3. Mail -----------------------------------------------------------------
#
# mail  = PHP mail() — works on most cPanel accounts with no further setup
# smtp  = an SMTP server (cPanel → Email Accounts gives you host/user/password)
VP_MAIL_DRIVER=mail
VP_MAIL_HOST=
VP_MAIL_PORT=587
VP_MAIL_USER=
VP_MAIL_PASS=
VP_MAIL_CRYPTO=tls
VP_MAIL_FROM_ADDRESS=noreply@yourdomain.com
VP_MAIL_FROM_NAME=WINDELS PANEL
# Set to 1 to write outgoing mail to the log instead of sending it (staging).
MAIL_LOG=false


# --- 4. Sessions, cache and uploads ------------------------------------------
#
# The defaults are files-on-disk, which is what shared hosting supports. The
# directories are created automatically; see docs/cpanel-deployment.md for the
# permissions to set if your host does not allow that.
VP_SESSION_DRIVER=files
VP_SESSION_COOKIE=windels_session
VP_SESSION_EXPIRATION=7200
VP_CACHE_DRIVER=file

# Absolute paths, only if you want them somewhere other than the defaults
# (storage/logs, storage/cache, assets/uploads under the application root).
# VP_STORAGE_PATH=
# VP_LOG_PATH=
# VP_UPLOAD_PATH=
# VP_UPLOAD_URL=

# Local disk, or s3 for an S3-compatible bucket (requires the aws-sdk in
# vendor/, which the standard cPanel package does not ship).
VP_STORAGE_DRIVER=local
VP_STORAGE_ENDPOINT=
VP_STORAGE_REGION=
VP_STORAGE_BUCKET=
VP_STORAGE_ACCESS_KEY=
VP_STORAGE_SECRET_KEY=
VP_STORAGE_URL=


# --- 5. Redis (optional — leave empty on shared hosting) ---------------------
#
# Nothing in the request path needs Redis: rate limiting is table-backed and
# sessions/cache default to files. Set these only where Redis actually runs.
VP_REDIS_ENABLED=false
VP_REDIS_HOST=
VP_REDIS_PORT=6379
VP_REDIS_PASSWORD=
VP_REDIS_DB=0
VP_REDIS_PREFIX=windels:


# --- 6. Application behaviour ------------------------------------------------

VP_TIMEZONE=UTC
VP_DEBUG=false
VP_MAINTENANCE_MODE=false
DEMO_MODE=false

# Allow provider/webhook HTTP to reach private/LAN addresses. Leave off unless
# you self-host providers on the same network — it disables SSRF protection.
HTTP_ALLOW_PRIVATE_HOSTS=false


# --- 7. Payment gateways (optional) ------------------------------------------
#
# Only `manual` (bank transfer, admin-reviewed) is wired into PaymentService
# today; the rest are scaffolds and stay inactive until completed. Keys live
# here and never in the database or the repo.
VP_STRIPE_SECRET_KEY=
VP_STRIPE_WEBHOOK_SECRET=
VP_PAYPAL_CLIENT_ID=
VP_PAYPAL_SECRET=
VP_PAYPAL_WEBHOOK_ID=
VP_FLUTTERWAVE_SECRET_KEY=
VP_RAZORPAY_KEY_ID=
VP_RAZORPAY_KEY_SECRET=
VP_PAYSTACK_SECRET_KEY=
VP_PAYSTACK_PUBLIC_KEY=
VP_COINPAYMENTS_MERCHANT_ID=
VP_COINPAYMENTS_IPN_SECRET=


# --- 8. Fulfilment providers (optional) --------------------------------------
#
# Without credentials the panel uses its offline mock adapters, which are
# refused outright in production — so a live panel sells only what has a real
# provider configured and activated in Admin → Providers.

# VTU (airtime, data, cable, electricity, exam PINs)
VP_VTPASS_BASE_URL=https://vtpass.com/api
VP_VTPASS_API_KEY=
VP_VTPASS_PUBLIC_KEY=
VP_VTPASS_SECRET_KEY=

# Virtual numbers / OTP. 5sim quotes roubles; FIVESIM_RATE_TO_BASE is how many
# naira one rouble is worth. Leave unset and vendor costs are reported
# unconverted rather than wrong.
VP_FIVESIM_BASE_URL=https://5sim.net/v1
VP_FIVESIM_API_KEY=
VP_FIVESIM_RATE_TO_BASE=

# Identity / KYC. Every lookup is billable, including ones that find no record.
VP_DOJAH_BASE_URL=https://api.dojah.io
VP_DOJAH_API_KEY=
VP_DOJAH_APP_ID=

# Gift cards. Cards are billed to your Reloadly wallet at order time, so the
# shipped default is the sandbox — switch it to https://giftcards.reloadly.com
# only when you are ready to spend real money.
VP_RELOADLY_BASE_URL=https://giftcards-sandbox.reloadly.com
VP_RELOADLY_CLIENT_ID=
VP_RELOADLY_CLIENT_SECRET=
# Legacy spellings understood too: RELOADLY_CLIENT_ID, RELOADLY_CLIENT_SECRET,
# RELOADLY_BASE_URL, GIFTCARD_COUNTRIES.
# Which markets the gift card catalogue sync imports (ISO-2, comma separated).
VP_GIFTCARD_COUNTRIES=US,GB,NG


# =============================================================================
# Compatibility note
#
# Every setting above also answers to its historical name without the VP_
# prefix — APP_URL, DB_NAME, DB_PASSWORD, ENCRYPTION_KEY, APP_KEY, SMTP_HOST,
# SESS_DRIVER, and so on. If both are present the un-prefixed one wins, so an
# existing .env (or a docker-compose stack that injects real environment
# variables) keeps working unchanged. See .env.production.example for the
# container-stack variant.
# =============================================================================
