# WINDELS PANEL — Environment Configuration
# Copy to .env and fill real values. Never commit .env.
# See application/config/*.php for usage (getenv / $_ENV)

APP_ENV=development
APP_URL=http://localhost:8080
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_KEY=base64:change-me-32chars-encryption-key-for-at-rest
# REQUIRED. Encrypts provider API keys and MFA secrets at rest. The app refuses
# to boot in production while this is unset, too short or still the value below.
#   openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-byte-base64-key-please-replace

# Database — MySQL / MariaDB
DB_DRIVER=mysqli
DB_HOST=mysql
DB_PORT=3306
DB_NAME=windels_panel
DB_USER=windels
DB_PASSWORD=windels_secret
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Redis — cache / rate limiting / distributed locks
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=windels:

# Session — database | redis
SESS_DRIVER=redis
SESS_SAVE_PATH=tcp://redis:6379?prefix=windels_sess:
SESS_COOKIE_NAME=windels_session
SESS_EXPIRATION=7200

# Storage — S3-compatible (AWS S3 / Cloudflare R2 / MinIO dev)
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=windels-panel
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_URL=

# Email — SMTP or API
MAIL_DRIVER=smtp
# Set MAIL_LOG=1 in development to write queued emails (incl. verify/reset links) to the log.
MAIL_LOG=false
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_CRYPTO=
MAIL_FROM_ADDRESS=noreply@windels.local
MAIL_FROM_NAME=WINDELS PANEL

# Payment gateways — keys via env, never in repo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
FLUTTERWAVE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYSTACK_SECRET_KEY=
COINPAYMENTS_PRIVATE_KEY=

# VTU vendor — VTpass (airtime, data, cable, electricity, exam PINs).
# Optional. With all three set, `php index.php seed demo` creates an INACTIVE
# VTpass provider you can test and activate from Admin → Providers; without
# them the panel keeps using the offline MOCK adapter.
# VTpass issues three values and splits them by HTTP method: api-key on every
# call, public-key on GETs (balance, verify, variations), secret-key on POSTs
# (purchases). Get sandbox keys at https://sandbox.vtpass.com.
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# Virtual-number vendor — 5sim (OTP numbers). Optional. With a token set,
# `php index.php seed demo` creates an INACTIVE 5sim provider you can test and
# activate from Admin -> Providers; without it the panel keeps using the
# offline MOCK_NUMBER adapter.
# 5sim prices everything in roubles while this panel is denominated in naira,
# so FIVESIM_RATE_TO_BASE is how many base-currency units one rouble is worth.
# Leave it unset and vendor costs are reported unconverted rather than wrong.
FIVESIM_BASE_URL=https://5sim.net/v1
FIVESIM_API_KEY=
FIVESIM_RATE_TO_BASE=

# Identity / KYC vendor — Dojah (NIN, BVN). Optional. With both values set,
# `php index.php seed demo` creates an INACTIVE Dojah provider you can test and
# activate from Admin -> Providers; without them the panel keeps using the
# offline MOCK_IDENTITY adapter.
# Dojah needs two headers, not one: the secret key goes in Authorization with
# NO "Bearer " prefix, and the AppId goes in its own header. Missing either is
# a flat 401. The URL below is the sandbox — sandbox keys do not work against
# https://api.dojah.io, and vice versa.
# Note that every lookup is billable, including ones that find no record, so
# price the identity products against your contract before activating.
DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_API_KEY=
DOJAH_APP_ID=

# Gift card vendor — Reloadly. Optional. With both values set, `php index.php
# seed demo` creates an INACTIVE Reloadly provider you can sync, price and
# activate from Admin -> Providers; without them the panel keeps using the
# offline MOCK_GIFTCARD adapter.
# Reloadly is OAuth2, not an API key: the client id/secret pair is exchanged
# for a bearer token that lasts ~60 days and is cached on the provider row.
# Tokens are scoped per product — a gift card token will not authenticate the
# airtime API — and the adapter picks the audience from the URL below, so a
# sandbox URL can never end up holding a production token.
# Cards are billed to your Reloadly wallet at order time, including orders
# whose code never reaches the customer, so keep an eye on the balance.
RELOADLY_BASE_URL=https://giftcards-sandbox.reloadly.com
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=

# Which gift card markets the catalogue sync imports (comma-separated ISO-2).
# Reloadly lists thousands of products across 140 countries; importing all of
# them buries the handful you will actually price.
GIFTCARD_COUNTRIES=US,GB,NG

# App. Booleans accept 1/true/yes/on; anything else (including "false") is off.
MAINTENANCE_MODE=false
DEMO_MODE=false

# Allow provider/webhook HTTP to reach private/LAN addresses. Leave off unless
# you self-host providers on the same network — it disables SSRF protection.
HTTP_ALLOW_PRIVATE_HOSTS=false

# Seeding — pins the password used by `php index.php seed demo`.
# Leave empty to have a random one generated and printed once.
# The demo seed refuses to run when APP_ENV=production (override with --force).
DEMO_PASSWORD=
