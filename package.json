{
  "name": "windels-panel-assets",
  "version": "0.4.0",
  "private": true,
  "description": "WINDELS PANEL — frontend asset build (Tailwind CLI). PHP views render with assets/css/design-system.css even without a build.",
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./assets/css/tailwind.css --minified",
    "watch:css": "tailwindcss -i ./assets/css/app.css -o ./assets/css/tailwind.css --watch",
    "build": "npm run build:css",
    "test:js": "node tests/js/chatbot.open.test.mjs",
    "test": "node tests/js/chatbot.open.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.0",
    "lucide": "^0.441.0",
    "php-parser": "^3.7.0",
    "tailwindcss": "^3.4.10"
  }
}
