# WINDELS PANEL — PRODUCTION environment template (container / managed server)
# -----------------------------------------------------------------------------
# Deploying on cPanel or other shared hosting? Use .env.example instead — it is
# written around the same settings under their portable VP_* names and defaults
# to files-on-disk sessions/cache/storage, which is what shared hosting has.
# Both spellings are understood everywhere; the un-prefixed names below win
# when both are set. Full guide: docs/cpanel-deployment.md
# -----------------------------------------------------------------------------
# Copy to .env on the production host (or, better, inject these from your
# secret manager — 1Password/SSM/Vault/Doppler). Never commit a filled .env.
# Every value below marked REQUIRED must be set; the compose file refuses to
# boot while any of them is empty, and `php index.php deploy check` refuses
# to start php-fpm while any of them is unsafe.

APP_ENV=production
CI_ENV=production
APP_URL=https://panel.example.com      # REQUIRED, must be https://
APP_DEBUG=false
APP_TIMEZONE=UTC

# REQUIRED — 64-hex-chars master key for AES-256-GCM at-rest encryption
# (provider API keys, MFA secrets, gift card codes).
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
ENCRYPTION_KEY=

# REQUIRED — signing key for sessions/signed tokens (falls back to
# ENCRYPTION_KEY when unset; setting both isolates the two planes).
APP_KEY=

# Database — MySQL 8 / MariaDB. With docker-compose.production.yml these four
# are REQUIRED by compose interpolation; with a managed database only DB_* is
# consumed by the app. Generate long random passwords; the deploy preflight
# FAILS while DB_PASSWORD is a known default.
DB_DRIVER=mysqli
DB_HOST=mysql                          # or your managed endpoint
DB_PORT=3306
DB_NAME=windels_panel                  # REQUIRED
DB_USER=windels_production             # REQUIRED
DB_PASSWORD=                           # REQUIRED, random 24+ chars
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
MYSQL_ROOT_PASSWORD=                   # REQUIRED by compose (root superuser)

# Redis — REQUIRED password in production (compose commands it with
# --requirepass; the session save path must carry ?auth=).
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                        # REQUIRED, random 24+ chars
REDIS_DB=0
REDIS_PREFIX=windels:
SESS_DRIVER=redis
SESS_SAVE_PATH=tcp://redis:6379?auth=${REDIS_PASSWORD}&prefix=windels_sess:
SESS_COOKIE_NAME=windels_session
SESS_EXPIRATION=7200

# Object storage — managed S3-compatible bucket (AWS S3, Cloudflare R2).
# There is no MinIO in production.
STORAGE_DRIVER=s3
STORAGE_ENDPOINT=                      # e.g. https://s3.eu-west-1.amazonaws.com
STORAGE_REGION=eu-west-1
STORAGE_BUCKET=windels-panel-prod      # REQUIRED
STORAGE_ACCESS_KEY=                    # REQUIRED
STORAGE_SECRET_KEY=                    # REQUIRED
STORAGE_URL=                           # public CDN/object URL, if any

# Email — real SMTP. There is no MailHog in production.
MAIL_DRIVER=smtp
MAIL_LOG=false
SMTP_HOST=                             # REQUIRED
SMTP_PORT=587
SMTP_USER=                             # REQUIRED
SMTP_PASSWORD=                         # REQUIRED
SMTP_CRYPTO=tls
MAIL_FROM_ADDRESS=noreply@panel.example.com
MAIL_FROM_NAME=WINDELS PANEL

# Payment gateways — set only what you enable; keys via env, never in repo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
FLUTTERWAVE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYSTACK_SECRET_KEY=
COINPAYMENTS_PRIVATE_KEY=

# Fulfilment providers — production endpoints and LIVE keys. Sandbox keys are
# refused by the adapters' base URLs, and MOCK providers are refused entirely:
# deploy preflight fails while any ACTIVE provider row uses a MOCK adapter.
VTPASS_BASE_URL=https://vtpass.com/api
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
FIVESIM_BASE_URL=https://5sim.net/v1
FIVESIM_API_KEY=
FIVESIM_RATE_TO_BASE=
DOJAH_BASE_URL=https://api.dojah.io
DOJAH_API_KEY=
DOJAH_APP_ID=
RELOADLY_BASE_URL=https://giftcards.reloadly.com
RELOADLY_CLIENT_ID=
RELOADLY_CLIENT_SECRET=
GIFTCARD_COUNTRIES=US,GB,NG

# Never on in production — preflight warns and demo seeding is refused.
MAINTENANCE_MODE=false
DEMO_MODE=false

# SSRF guard: leave false unless providers live on your LAN.
HTTP_ALLOW_PRIVATE_HOSTS=false

# DEMO_PASSWORD intentionally absent — demo data never runs in production.
