# =============================================================================
# MarvySocials — production environment (Docker stack reference)
#
# Every REQUIRED value must be set before boot: the production compose file
# fails to render (`${VAR:?}`) and the web container's deploy gate refuses to
# serve until preflight is green. Plain (non-VP_) names are used here because
# that is what docker-compose references; both naming schemes work at runtime
# (see .env.example for the full annotated reference — the same keys apply).
#
# NEVER commit a filled copy of this file.
# =============================================================================

# ----------------------------- REQUIRED --------------------------------------
APP_ENV=production
CI_ENV=production
APP_URL=https://panel.example.com      # REQUIRED — must be https
APP_DEBUG=false
APP_TIMEZONE=UTC

# 64 hex chars (openssl rand -hex 32) — at-rest encryption. Boot refusal if empty.
ENCRYPTION_KEY=
# 32+ random chars — HMAC for password-reset / email-verification tokens.
APP_KEY=

# Application database (consumed by the app AND the mysql container).
DB_DRIVER=mysqli
DB_HOST=mysql                          # or your managed endpoint (RDS/Aurora)
DB_PORT=3306
DB_NAME=marvysocials                  # REQUIRED
DB_USER=marvy_production             # REQUIRED
# REQUIRED — 24+ random chars
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Compose-only (MySQL container bootstrap; not read by the application):
# REQUIRED — 24+ random chars
MYSQL_ROOT_PASSWORD=
MYSQL_USER=${DB_USER}
MYSQL_PASSWORD=${DB_PASSWORD}

# ----------------------------- SESSIONS / CACHE ------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# REQUIRED — 24+ random chars
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=marvy:

SESS_DRIVER=redis
# ${REDIS_PASSWORD} interpolates because REDIS_PASSWORD is defined above.
SESS_SAVE_PATH=tcp://redis:6379?auth=${REDIS_PASSWORD}&prefix=marvy_sess:
SESS_COOKIE_NAME=marvy_session
SESS_EXPIRATION=7200

# ----------------------------- MAIL (REQUIRED) -------------------------------
MAIL_DRIVER=smtp
MAIL_LOG=false
# REQUIRED
SMTP_HOST=
SMTP_PORT=587
# REQUIRED
SMTP_USER=
# REQUIRED
SMTP_PASSWORD=
SMTP_CRYPTO=tls
MAIL_FROM_ADDRESS=noreply@panel.example.com
MAIL_FROM_NAME=MarvySocials

# ----------------------------- STORAGE ---------------------------------------
# local = uploads on the app volume (fine for a single node).
# s3/R2 = set the bucket + credentials (driver wiring lands with the object
# storage module; values are read today so they can already be provisioned).
STORAGE_DRIVER=local
# STORAGE_ENDPOINT=https://s3.eu-west-1.amazonaws.com   # or R2 endpoint
# STORAGE_REGION=eu-west-1
# STORAGE_BUCKET=marvysocials-prod
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_URL=                          # public bucket/CDN URL, if any

# ----------------------------- SECURITY --------------------------------------
CSRF_EXPIRE=7200
CSRF_REGENERATE=false
# Cookie security: automatically true over HTTPS, false over HTTP.
# Override explicitly if testing on HTTP before SSL is active: VP_COOKIE_SECURE=false
# VP_COOKIE_SECURE=false
DEMO_MODE=false                        # Preflight warns if true in production
HTTP_ALLOW_PRIVATE_HOSTS=false         # SSRF guard — leave false
# MAINTENANCE_MODE — runtime flag lives in Admin → Settings (DB), not in .env.

# One-time browser setup (set → visit /setup?token=… → REMOVE the line):
# SETUP_TOKEN=

# Disable the bundled diagnostics (or just delete deploy-verify.php):
# VP_VERIFY_DISABLE=1

# ------------------ PAYMENT GATEWAYS (optional, disabled until wired) --------
# Only 'manual' is active today (config/payment_gateways.php). Fill these the
# day you enable one; webhook secrets can also use MARVYSOCIALS_<GW>_WEBHOOK_SECRET.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_SECRET=
# FLUTTERWAVE_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=
# COINPAYMENTS_MERCHANT_ID=
# COINPAYMENTS_IPN_SECRET=

# ------------------ UPSTREAM PROVIDERS (optional, live adapters) -------------
# VTU — VTpass
# VTPASS_BASE_URL=https://vtpass.com/api
# VTPASS_API_KEY=
# VTPASS_PUBLIC_KEY=
# VTPASS_SECRET_KEY=
# Virtual numbers — 5sim (CURRENT protocol)
# Use the dashboard key "API key for 5sim protocol" (NOT the one labelled
# "Deprecated API"). The adapter refuses the deprecated API1/handler_api
# endpoints. Server-side only: never expose this key to the browser, never
# commit it. Rotating it here takes effect on the next request — no redeploy.
# FIVESIM_BASE_URL=https://5sim.net/v1
# FIVESIM_API_KEY=
# FIVESIM_RATE_TO_BASE=

# Identity / KYC — Dojah
# DOJAH_BASE_URL=https://api.dojah.io
# DOJAH_API_KEY=
# DOJAH_APP_ID=
# Gift cards — Reloadly
# RELOADLY_BASE_URL=https://giftcards.reloadly.com
# RELOADLY_CLIENT_ID=
# RELOADLY_CLIENT_SECRET=
# GIFTCARD_COUNTRIES=US,GB,NG
