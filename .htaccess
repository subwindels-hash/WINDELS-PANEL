# CodeIgniter .htaccess — required for clean URLs / routing on cPanel / Apache

# Disable directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS is terminated by cPanel AutoSSL / LiteSpeed / the CDN. Do not
    # add an HTTP→HTTPS RewriteRule here: a host that already redirects
    # (cPanel → Domains → Force HTTPS Redirect) would loop. Env.php upgrades
    # an http:// VP_BASE_URL to https:// when the request itself is TLS, so
    # generated links match the browser without a rewrite.

    # Deny direct access to sensitive directories (parity with
    # docker/nginx/nginx.conf and nginx.prod.conf deny rules).
    RewriteRule ^(application|system|storage|vendor|docs|database|tests|tools|cron|node_modules)(/|$) - [F,L]

    # Deny dotfiles and dot-directories (.env, .git, ...).
    RewriteRule (^|/)\. - [F,L]

    # Front controller: everything that is not a real file/directory.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>

# Belt and braces for the two files that are worth stealing on their own: the
# environment file (every credential) and the production database dump (schema
# plus the seeded administrator hash). The RewriteRules above already cover
# them where mod_rewrite is enabled; these work even where it is not.
<FilesMatch "(^\.env|\.sql|\.sql\.gz|\.zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect dotfiles even when mod_rewrite is unavailable.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers for production
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
